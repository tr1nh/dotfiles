# colorscheme
*.background: #000000
*.foreground: #ffffff

# xterm
XTerm*font: xft:Noto Mono:pixelsize=15
UXTerm*font: xft:Noto Mono:pixelsize=15

# rxvt
URxvt*font: xft:Noto Mono:pixelsize=15
URxvt*scrollBar: false

# rxvt resize font
URxvt.perl-ext-common: font-size
# URxvt.keysym.C-Up:     font-size:increase
# URxvt.keysym.C-Down:   font-size:decrease
# URxvt.keysym.C-S-Up:   font-size:incglobal
# URxvt.keysym.C-S-Down: font-size:decglobal
# URxvt.keysym.C-equal:  font-size:reset
# URxvt.keysym.C-slash:  font-size:show

# colorscheme tango-dark
*.color0: #000000
*.color1: #cc0000
*.color2: #4e9a05
*.color3: #c4a000
*.color4: #3464a4
*.color5: #74507a
*.color6: #05989a
*.color7: #d3d7cf
*.color8: #545753
*.color9: #ef2828
*.color10: #8ae234
*.color11: #fce94e
*.color12: #719ecf
*.color13: #ad7ea7
*.color14: #34e2e2
*.color15: #ededec
*.foreground: #ffffff
*.background: #000000
*.cursor: #ffffff
